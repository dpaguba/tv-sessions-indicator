// ==================== HELPER FUNCTIONS ====================

// Convert label size string to Pine Script constant
get_label_size(size_str) =>
    size_str == "tiny" ? size.tiny :
     size_str == "small" ? size.small :
     size_str == "normal" ? size.normal :
     size_str == "large" ? size.large :
     size.huge

// Convert time string to minutes from midnight (supports HH:MM and HH:MM format)
parse_time(time_str) =>
    parts = str.split(time_str, ":")
    hour_val = str.tonumber(array.get(parts, 0))
    minute_part = array.get(parts, 1)
    minute_val = str.tonumber(minute_part)
    hour_val * 60 + minute_val

// Check if current bar is in session (UTC-based)
in_session(start_time_str, end_time_str) =>
    start_minutes = parse_time(start_time_str)
    end_minutes = parse_time(end_time_str)
    current_minutes = hour(time, "UTC") * 60 + minute(time, "UTC")

    if end_minutes < start_minutes
        // Session crosses midnight
        current_minutes >= start_minutes or current_minutes < end_minutes
    else
        current_minutes >= start_minutes and current_minutes < end_minutes

// Detect session start (UTC-based)
is_session_start(start_time_str) =>
    start_minutes = parse_time(start_time_str)
    current_minutes = hour(time, "UTC") * 60 + minute(time, "UTC")
    prev_minutes = hour(time[1], "UTC") * 60 + minute(time[1], "UTC")

    // Check if we just crossed into the session start time
    if prev_minutes < start_minutes and current_minutes >= start_minutes
        true
    else if start_minutes == 0 and prev_minutes > current_minutes
        // Handle midnight crossing
        true
    else
        false

// Detect session end (UTC-based)
is_session_end(end_time_str) =>
    end_minutes = parse_time(end_time_str)
    current_minutes = hour(time, "UTC") * 60 + minute(time, "UTC")
    prev_minutes = hour(time[1], "UTC") * 60 + minute(time[1], "UTC")

    // Check if we just crossed the session end time
    if prev_minutes < end_minutes and current_minutes >= end_minutes
        true
    // Handle midnight crossing
    else if end_minutes == 0 and prev_minutes > current_minutes
        true
    // Handle end of day (23:00 -> 00:00 next day)
    else if end_minutes >= 1380 and current_minutes < 60 and prev_minutes > end_minutes
        true
    else
        false

// ==================== SESSION TRACKING ====================

// Session state variables will be managed by process_session function

// ==================== DRAW SESSION BOX FUNCTION ====================

draw_session_box(start_bar, end_bar, sess_high, sess_low, sess_color, transparency, extend, sess_name, show_zone, zone_mins, zone_transp, old_box, old_label, old_zone_box) =>
    var box new_box = na
    var label new_label = na
    var box new_zone_box = na

    if not na(start_bar) and not na(sess_high) and not na(sess_low)
        // Delete old boxes (always delete during active session for real-time updates)
        if not na(old_box)
            box.delete(old_box)
        if not na(old_label)
            label.delete(old_label)
        if not na(old_zone_box)
            box.delete(old_zone_box)

        // Draw main session box
        box_bg_color = color.new(sess_color, transparency)

        new_box := box.new(
             left=start_bar,
             top=sess_high,
             right=end_bar,
             bottom=sess_low,
             border_color=color.new(sess_color, 100),
             bgcolor=box_bg_color,
             border_width=0,
             extend=extend ? extend.right : extend.none
         )

        // Draw label
        if show_labels and sess_name != ""
            // Vertical position - at the edge of the box with small offset
            price_range = sess_high - sess_low
            offset = price_range * 0.04  // 4% offset from edge
            label_y = label_position == "Top" ? sess_high + offset : sess_low - offset

            // Horizontal position based on alignment
            label_x = label_align == "Left" ? start_bar :
                     label_align == "Right" ? end_bar :
                     int((start_bar + end_bar) / 2)

            // Determine label style based on position and alignment
            // For Left: text goes RIGHT from anchor point (stays inside box)
            // For Right: text goes LEFT from anchor point (stays inside box)
            label_style_val = label.style_label_center

            if label_position == "Top"
                if label_align == "Left"
                    label_style_val := label.style_label_left
                else if label_align == "Right"
                    label_style_val := label.style_label_right
                else
                    label_style_val := label.style_label_down
            else  // Bottom
                if label_align == "Left"
                    label_style_val := label.style_label_left
                else if label_align == "Right"
                    label_style_val := label.style_label_right
                else
                    label_style_val := label.style_label_up

            new_label := label.new(
                 x=label_x,
                 y=label_y,
                 text=sess_name,
                 color=color.new(sess_color, 100),
                 textcolor=sess_color,
                 style=label_style_val,
                 size=get_label_size(label_size)
             )

        // Draw Zone (shaded area around open/close)
        if show_zone
            zone_bars = zone_mins / timeframe.multiplier
            zone_end_bar = start_bar + int(zone_bars)
            zone_color = color.new(sess_color, zone_transp)

            // Zone uses the same high/low as the full session
            // In future could be enhanced to calculate actual high/low of zone period
            zone_high = sess_high
            zone_low = sess_low

            new_zone_box := box.new(
                 left=start_bar,
                 top=zone_high,
                 right=zone_end_bar,
                 bottom=zone_low,
                 border_color=color.new(sess_color, zone_transp),
                 bgcolor=zone_color,
                 border_width=0
             )

    [new_box, new_label, new_zone_box]

