// ==================== PROCESS ALL SESSIONS ====================

// Session 1: New York
if session1_enabled
    start_time = use_dst ? session1_start_dst : session1_start_std
    end_time = use_dst ? session1_end_dst : session1_end_std

    if is_session_start(start_time)
        s1_active := true
        s1_start_bar := bar_index
        s1_high := high
        s1_low := low

    if s1_active
        s1_high := math.max(s1_high, high)
        s1_low := math.min(s1_low, low)

        // Update box in real-time during active session
        [new_box, new_label, new_zone] = draw_session_box(s1_start_bar, bar_index, s1_high, s1_low,
             session1_color, box_transparency,
             session1_extend, session1_name, session1_zone, zone_periods,
             zone_transparency, s1_box, s1_label, s1_zone_box)
        s1_box := new_box
        s1_label := new_label
        s1_zone_box := new_zone

    if is_session_end(end_time) and s1_active
        s1_active := false

