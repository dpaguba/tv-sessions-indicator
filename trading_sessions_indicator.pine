//@version=5
indicator("TR I Sessions", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ==================== GENERAL SETTINGS ====================
show_history = input.bool(true, "Show History", group="GENERAL")
use_dst = input.bool(true, "Use DST (Daylight Saving Time)", group="GENERAL", tooltip="When enabled, sessions will use DST open/close times. When disabled, sessions will use standard time.")

// ==================== BOX SETTINGS ====================
box_transparency = input.int(93, "Box Transparency", minval=0, maxval=100, group="BOX SETTINGS", inline="box1")

// ==================== LABEL SETTINGS ====================
show_labels = input.bool(true, "Display Session Labels", group="LABEL SETTINGS")
label_size = input.string("small", "Label Size", options=["tiny", "small", "normal", "large", "huge"], group="LABEL SETTINGS")
label_position = input.string("Top", "Position", options=["Top", "Bottom"], group="LABEL SETTINGS", inline="label2")
label_align = input.string("Left", "Align", options=["Left", "Center", "Right"], group="LABEL SETTINGS", inline="label3")

// ==================== SESSION 1: TOKYO ====================
session1_enabled = input.bool(true, "Enable", group="SESSION 1: TOKYO", inline="s1")
session1_name = input.string("Tokyo", "Name", group="SESSION 1: TOKYO", inline="s1")
session1_color = input.color(color.new(#5E81AC, 0), "Color", group="SESSION 1: TOKYO", inline="s1")

session1_start_dst = input.string("00:00", "DST Open", options=["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"], group="SESSION 1: TOKYO", inline="s1_dst")
session1_end_dst = input.string("09:00", "Close", options=["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"], group="SESSION 1: TOKYO", inline="s1_dst")

session1_start_std = input.string("00:00", "No DST Open", options=["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"], group="SESSION 1: TOKYO", inline="s1_std")
session1_end_std = input.string("09:00", "Close", options=["00:00", "01:00", "02:00", "03:00", "04:00", "05:00", "06:00", "07:00", "08:00", "09:00", "10:00", "11:00", "12:00", "13:00", "14:00", "15:00", "16:00", "17:00", "18:00", "19:00", "20:00", "21:00", "22:00", "23:00"], group="SESSION 1: TOKYO", inline="s1_std")

session1_extend = input.bool(false, "Extend", group="SESSION 1: TOKYO", inline="s1_opt")

