// ==================== HELPER FUNCTIONS ====================

// Convert label size string to Pine Script constant
get_label_size(size_str) =>
    size_str == "tiny" ? size.tiny :
     size_str == "small" ? size.small :
     size_str == "normal" ? size.normal :
     size_str == "large" ? size.large :
     size.huge

// Convert time string to minutes from midnight
parse_time(time_str) =>
    parts = str.split(time_str, ":")
    hour_val = str.tonumber(array.get(parts, 0))
    minute_part = array.get(parts, 1)
    minute_val = str.tonumber(minute_part)
    hour_val * 60 + minute_val

// Detect session start (UTC-based)
is_session_start(start_time_str) =>
    start_minutes = parse_time(start_time_str)
    current_minutes = hour(time, "UTC") * 60 + minute(time, "UTC")
    prev_minutes = hour(time[1], "UTC") * 60 + minute(time[1], "UTC")

    // Check if we just crossed into the session start time
    if prev_minutes < start_minutes and current_minutes >= start_minutes
        true
    else if start_minutes == 0 and prev_minutes > current_minutes
        // Handle midnight crossing
        true
    else
        false

// Detect session end (UTC-based)
is_session_end(end_time_str) =>
    end_minutes = parse_time(end_time_str)
    current_minutes = hour(time, "UTC") * 60 + minute(time, "UTC")
    prev_minutes = hour(time[1], "UTC") * 60 + minute(time[1], "UTC")

    // Check if we just crossed the session end time
    if prev_minutes < end_minutes and current_minutes >= end_minutes
        true
    // Handle midnight crossing
    else if end_minutes == 0 and prev_minutes > current_minutes
        true
    // Handle end of day (23:00 -> 00:00 next day)
    else if end_minutes >= 1380 and current_minutes < 60 and prev_minutes > end_minutes
        true
    else
        false

// Check if currently in session (UTC-based)
in_session(start_time_str, end_time_str) =>
    start_minutes = parse_time(start_time_str)
    end_minutes = parse_time(end_time_str)
    current_minutes = hour(time, "UTC") * 60 + minute(time, "UTC")

    // Handle sessions that cross midnight
    if start_minutes > end_minutes
        current_minutes >= start_minutes or current_minutes < end_minutes
    else
        current_minutes >= start_minutes and current_minutes < end_minutes

// ==================== DRAW SESSION BOX FUNCTION ====================

draw_session_box(start_time, end_time, sess_color, transparency, extend, sess_name, enabled) =>
    if enabled
        // State variables - each function call gets its own instance
        var float sessionHigh = na
        var float sessionLow = na
        var int sessionStartBar = na
        var box sessionBox = na
        var label sessionLabel = na
        var bool isActive = false

        // Detect session start
        sessionStart = is_session_start(start_time)

        // Detect session end
        sessionEnd = is_session_end(end_time)

        // Check if we're currently in session
        inSession = in_session(start_time, end_time)

        if sessionStart
            isActive := true
            // Initialize session tracking
            sessionHigh := high
            sessionLow := low
            sessionStartBar := bar_index

            // Delete old box if history is disabled
            if not show_history and not na(sessionBox)
                box.delete(sessionBox)
                sessionBox := na
            if not show_history and not na(sessionLabel)
                label.delete(sessionLabel)
                sessionLabel := na

            // Create initial box and label at session start
            box_bg_color = color.new(sess_color, transparency)
            sessionBox := box.new(
                 left=sessionStartBar,
                 top=sessionHigh,
                 right=bar_index,
                 bottom=sessionLow,
                 border_color=color.new(sess_color, 100),
                 bgcolor=box_bg_color,
                 border_width=0,
                 extend=extend ? extend.right : extend.none
             )

            // Create label
            if show_labels and sess_name != ""
                price_range = sessionHigh - sessionLow
                offset = price_range * 0.04
                label_y = label_position == "Top" ? sessionHigh + offset : sessionLow - offset

                label_x = label_align == "Left" ? sessionStartBar :
                         label_align == "Right" ? bar_index :
                         int((sessionStartBar + bar_index) / 2)

                label_style_val = label.style_label_center
                if label_position == "Top"
                    if label_align == "Left"
                        label_style_val := label.style_label_left
                    else if label_align == "Right"
                        label_style_val := label.style_label_right
                    else
                        label_style_val := label.style_label_down
                else
                    if label_align == "Left"
                        label_style_val := label.style_label_left
                    else if label_align == "Right"
                        label_style_val := label.style_label_right
                    else
                        label_style_val := label.style_label_up

                sessionLabel := label.new(
                     x=label_x,
                     y=label_y,
                     text=sess_name,
                     color=color.new(sess_color, 100),
                     textcolor=sess_color,
                     style=label_style_val,
                     size=get_label_size(label_size)
                 )

        else if inSession and isActive and not na(sessionBox)
            // Update high/low during active session
            sessionHigh := math.max(sessionHigh, high)
            sessionLow := math.min(sessionLow, low)

            // Update the existing box with new high/low and extend right edge
            box.set_top(sessionBox, sessionHigh)
            box.set_bottom(sessionBox, sessionLow)
            box.set_right(sessionBox, bar_index)

            // Update label position if it exists
            if not na(sessionLabel) and show_labels
                price_range = sessionHigh - sessionLow
                offset = price_range * 0.04
                label_y = label_position == "Top" ? sessionHigh + offset : sessionLow - offset

                label_x = label_align == "Left" ? sessionStartBar :
                         label_align == "Right" ? bar_index :
                         int((sessionStartBar + bar_index) / 2)

                label.set_x(sessionLabel, label_x)
                label.set_y(sessionLabel, label_y)

        if sessionEnd and isActive
            isActive := false
            // Finalize box position at session end
            if not na(sessionBox)
                box.set_right(sessionBox, bar_index)

// ==================== PROCESS ALL SESSIONS ====================

// Session 1: Tokyo
start_time1 = use_dst ? session1_start_dst : session1_start_std
end_time1 = use_dst ? session1_end_dst : session1_end_std
draw_session_box(start_time1, end_time1, session1_color, box_transparency, session1_extend, session1_name, session1_enabled)

// Session 2: Frankfurt
start_time2 = use_dst ? session2_start_dst : session2_start_std
end_time2 = use_dst ? session2_end_dst : session2_end_std
draw_session_box(start_time2, end_time2, session2_color, box_transparency, session2_extend, session2_name, session2_enabled)

// Session 3: London
start_time3 = use_dst ? session3_start_dst : session3_start_std
end_time3 = use_dst ? session3_end_dst : session3_end_std
draw_session_box(start_time3, end_time3, session3_color, box_transparency, session3_extend, session3_name, session3_enabled)

// Session 4: New York
start_time4 = use_dst ? session4_start_dst : session4_start_std
end_time4 = use_dst ? session4_end_dst : session4_end_std
draw_session_box(start_time4, end_time4, session4_color, box_transparency, session4_extend, session4_name, session4_enabled)

// Session 5: Other
start_time5 = use_dst ? session5_start_dst : session5_start_std
end_time5 = use_dst ? session5_end_dst : session5_end_std
draw_session_box(start_time5, end_time5, session5_color, box_transparency, session5_extend, session5_name, session5_enabled)
