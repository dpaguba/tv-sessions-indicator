// Session 7: Shenzhen
if session7_enabled
    start_time = use_dst ? session7_start_dst : session7_start_std
    end_time = use_dst ? session7_end_dst : session7_end_std

    if is_session_start(start_time)
        s7_active := true
        s7_start_bar := bar_index
        s7_high := high
        s7_low := low

    if s7_active
        s7_high := math.max(s7_high, high)
        s7_low := math.min(s7_low, low)

        // Update box in real-time during active session
        [new_box, new_label, new_zone] = draw_session_box(s7_start_bar, bar_index, s7_high, s7_low,
             session7_color, box_transparency,
             session7_extend, session7_name, session7_zone, zone_periods,
             zone_transparency, s7_box, s7_label, s7_zone_box)
        s7_box := new_box
        s7_label := new_label
        s7_zone_box := new_zone

    if is_session_end(end_time) and s7_active
        s7_active := false

