//@version=5
indicator("Trading Sessions Indicator", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// ==================== GENERAL SETTINGS ====================
timezone_input = input.string("GMT+2", "Timezone", group="GENERAL")
show_history = input.bool(true, "History", group="GENERAL")

// ==================== SESSION 1: LONDON ====================
session1_enabled = input.bool(true, "Session 1:", group="#1 SESSION", inline="s1")
session1_name = input.string("London", "", group="#1 SESSION", inline="s1")
session1_color = input.color(color.new(color.blue, 0), "", group="#1 SESSION", inline="s1")

session1_start = input.string("10:00", "Time", group="#1 SESSION", inline="s1_time")
session1_end = input.string("15:00", "", group="#1 SESSION", inline="s1_time")

session1_extend = input.bool(false, "Extend", group="#1 SESSION")
session1_fibonacci = input.bool(false, "Fibonacci", group="#1 SESSION")
session1_zone = input.bool(false, "Zone", group="#1 SESSION")

// ==================== SESSION 2: NEW YORK ====================
session2_enabled = input.bool(true, "Session 2:", group="#2 SESSION", inline="s2")
session2_name = input.string("New York", "", group="#2 SESSION", inline="s2")
session2_color = input.color(color.new(color.teal, 0), "", group="#2 SESSION", inline="s2")

session2_start = input.string("15:00", "Time", group="#2 SESSION", inline="s2_time")
session2_end = input.string("23:00", "", group="#2 SESSION", inline="s2_time")

session2_extend = input.bool(false, "Extend", group="#2 SESSION")
session2_fibonacci = input.bool(false, "Fibonacci", group="#2 SESSION")
session2_zone = input.bool(false, "Zone", group="#2 SESSION")

// ==================== SESSION 3: TOKYO ====================
session3_enabled = input.bool(true, "Session 3:", group="#3 SESSION", inline="s3")
session3_name = input.string("Tokyo", "", group="#3 SESSION", inline="s3")
session3_color = input.color(color.new(#5F6B8A, 0), "", group="#3 SESSION", inline="s3")

session3_start = input.string("02:00", "Time", group="#3 SESSION", inline="s3_time")
session3_end = input.string("09:00", "", group="#3 SESSION", inline="s3_time")

session3_extend = input.bool(false, "Extend", group="#3 SESSION")
session3_fibonacci = input.bool(false, "Fibonacci", group="#3 SESSION")
session3_zone = input.bool(false, "Zone", group="#3 SESSION")

// ==================== SESSION 4: FRANKFURT ====================
session4_enabled = input.bool(true, "Session 4:", group="#4 SESSION", inline="s4")
session4_name = input.string("Frankfurt", "", group="#4 SESSION", inline="s4")
session4_color = input.color(color.new(#C10080, 0), "", group="#4 SESSION", inline="s4")

session4_start = input.string("09:00", "Time", group="#4 SESSION", inline="s4_time")
session4_end = input.string("10:00", "", group="#4 SESSION", inline="s4_time")

session4_extend = input.bool(false, "Extend", group="#4 SESSION")
session4_fibonacci = input.bool(false, "Fibonacci", group="#4 SESSION")
session4_zone = input.bool(false, "Zone", group="#4 SESSION")

// ==================== BOX SETTINGS ====================
box_style_input = input.string("dot", "Stil", options=["solid", "dot", "dash"], group="BOX", inline="box1")
box_thickness = input.int(0, "Thickness", minval=0, maxval=5, group="BOX", inline="box2")
box_transparency = input.int(93, "Transparency", minval=0, maxval=100, group="BOX", inline="box3")

// ==================== FENSTER-LABEL (WINDOW LABEL) ====================
show_labels = input.bool(true, "Show labels", group="FENSTER-LABEL", inline="label1")
label_size = input.string("Klein", "", options=["Klein", "Normal", "Gross"], group="FENSTER-LABEL", inline="label1")

label_position = input.string("Top", "Position", options=["Top", "Middle", "Bottom"], group="FENSTER-LABEL", inline="label2")
label_location = input.string("Outside", "", options=["Inside", "Outside"], group="FENSTER-LABEL", inline="label2")

show_name = input.bool(true, "Name", group="FENSTER-LABEL", inline="label3")
show_kurs = input.bool(false, "Kurs", group="FENSTER-LABEL", inline="label3")
show_pips = input.bool(false, "Pips", group="FENSTER-LABEL", inline="label3")
show_tage = input.bool(false, "Tage", group="FENSTER-LABEL", inline="label3")

// ==================== FIBONACCI SETTINGS ====================
fib_style_input = input.string("sol", "Stil", options=["solid", "sol", "dash"], group="FIBONACCI", inline="fib1")
fib_thickness = input.int(1, "Thickness", minval=1, maxval=5, group="FIBONACCI", inline="fib2")

// ==================== ZONE SETTINGS ====================
zone_periods = input.int(20, "Periods (minutes)", minval=1, group="ZONE", inline="zone1")
zone_transparency = input.int(88, "Transparency", minval=0, maxval=100, group="ZONE", inline="zone2")

// ==================== HELPER FUNCTIONS ====================

// Convert border style string to Pine Script constant
get_border_style(style_str) =>
    style_str == "solid" ? line.style_solid :
     style_str == "dot" ? line.style_dotted :
     line.style_dashed

// Convert label size string to Pine Script constant
get_label_size(size_str) =>
    size_str == "Klein" ? size.small :
     size_str == "Normal" ? size.normal :
     size.large

// Convert time string to timestamp (in minutes from midnight)
parse_time(time_str) =>
    parts = str.split(time_str, ":")
    hour = str.tonumber(array.get(parts, 0))
    minute = str.tonumber(array.get(parts, 1))
    hour * 60 + minute

// Check if current bar is in session
in_session(start_time_str, end_time_str) =>
    start_minutes = parse_time(start_time_str)
    end_minutes = parse_time(end_time_str)
    current_minutes = hour(time) * 60 + minute(time)

    if end_minutes < start_minutes
        // Session crosses midnight
        current_minutes >= start_minutes or current_minutes < end_minutes
    else
        current_minutes >= start_minutes and current_minutes < end_minutes

// Detect session start
is_session_start(start_time_str) =>
    start_minutes = parse_time(start_time_str)
    current_minutes = hour(time) * 60 + minute(time)
    prev_minutes = hour(time[1]) * 60 + minute(time[1])

    // Check if we just crossed into the session start time
    if prev_minutes < start_minutes and current_minutes >= start_minutes
        true
    else if start_minutes == 0 and prev_minutes > current_minutes
        // Handle midnight crossing
        true
    else
        false

// Detect session end
is_session_end(end_time_str) =>
    end_minutes = parse_time(end_time_str)
    current_minutes = hour(time) * 60 + minute(time)
    prev_minutes = hour(time[1]) * 60 + minute(time[1])

    // Check if we just crossed the session end time
    if prev_minutes < end_minutes and current_minutes >= end_minutes
        true
    else if end_minutes == 0 and prev_minutes > current_minutes
        // Handle midnight crossing
        true
    else
        false

// ==================== SESSION TRACKING ====================

// Variables to track session highs and lows
var float session1_high = na
var float session1_low = na
var int session1_start_bar = na
var bool session1_active = false

var float session2_high = na
var float session2_low = na
var int session2_start_bar = na
var bool session2_active = false

var float session3_high = na
var float session3_low = na
var int session3_start_bar = na
var bool session3_active = false

var float session4_high = na
var float session4_low = na
var int session4_start_bar = na
var bool session4_active = false

// ==================== PROCESS SESSIONS ====================

draw_session_box(start_bar, end_bar, sess_high, sess_low, sess_color, border_style, thickness, transparency, extend, sess_name, show_fib, show_zone, zone_mins, zone_transp, fib_style, fib_thick) =>
    if not na(start_bar) and not na(sess_high) and not na(sess_low)
        // Draw main session box
        box_border_color = color.new(sess_color, 0)
        box_bg_color = color.new(sess_color, transparency)

        session_box = box.new(
             left=start_bar,
             top=sess_high,
             right=end_bar,
             bottom=sess_low,
             border_color=box_border_color,
             bgcolor=box_bg_color,
             border_width=thickness,
             border_style=border_style,
             extend=extend ? extend.right : extend.none
         )

        // Draw label
        if show_labels and show_name
            label_y = label_position == "Top" ? sess_high : label_position == "Bottom" ? sess_low : (sess_high + sess_low) / 2
            label_style_val = label_position == "Top" ?
                 (label_location == "Outside" ? label.style_label_down : label.style_label_up) :
                 label_position == "Bottom" ?
                 (label_location == "Outside" ? label.style_label_up : label.style_label_down) :
                 label.style_label_center

            label.new(
                 x=end_bar,
                 y=label_y,
                 text=sess_name,
                 color=sess_color,
                 textcolor=color.white,
                 style=label_style_val,
                 size=get_label_size(label_size)
             )

        // Draw Fibonacci levels
        if show_fib and not na(sess_high) and not na(sess_low)
            fib_border_style = get_border_style(fib_style)
            range_val = sess_high - sess_low

            // Fib levels: 0, 0.236, 0.382, 0.5, 0.618, 0.786, 1
            fib_levels = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.786, 1.0)

            for i = 0 to array.size(fib_levels) - 1
                fib_level = array.get(fib_levels, i)
                fib_price = sess_low + range_val * fib_level
                fib_color = color.new(sess_color, 50)

                line.new(
                     x1=start_bar,
                     y1=fib_price,
                     x2=end_bar,
                     y2=fib_price,
                     color=fib_color,
                     style=fib_border_style,
                     width=fib_thick,
                     extend=extend ? extend.right : extend.none
                 )

        // Draw Zone (shaded area around open/close)
        if show_zone
            zone_bars = zone_mins / timeframe.multiplier
            zone_end_bar = start_bar + int(zone_bars)
            zone_color = color.new(sess_color, zone_transp)

            // Get high/low during zone period
            var float zone_high = sess_high
            var float zone_low = sess_low

            box.new(
                 left=start_bar,
                 top=zone_high,
                 right=zone_end_bar,
                 bottom=zone_low,
                 border_color=color.new(sess_color, zone_transp),
                 bgcolor=zone_color,
                 border_width=0
             )

// ==================== SESSION 1: LONDON ====================
if session1_enabled
    if is_session_start(session1_start)
        session1_active := true
        session1_start_bar := bar_index
        session1_high := high
        session1_low := low

    if session1_active
        session1_high := math.max(session1_high, high)
        session1_low := math.min(session1_low, low)

    if is_session_end(session1_end) and session1_active
        session1_active := false
        draw_session_box(session1_start_bar, bar_index, session1_high, session1_low,
             session1_color, get_border_style(box_style_input), box_thickness, box_transparency,
             session1_extend, session1_name, session1_fibonacci, session1_zone, zone_periods,
             zone_transparency, fib_style_input, fib_thickness)

// ==================== SESSION 2: NEW YORK ====================
if session2_enabled
    if is_session_start(session2_start)
        session2_active := true
        session2_start_bar := bar_index
        session2_high := high
        session2_low := low

    if session2_active
        session2_high := math.max(session2_high, high)
        session2_low := math.min(session2_low, low)

    if is_session_end(session2_end) and session2_active
        session2_active := false
        draw_session_box(session2_start_bar, bar_index, session2_high, session2_low,
             session2_color, get_border_style(box_style_input), box_thickness, box_transparency,
             session2_extend, session2_name, session2_fibonacci, session2_zone, zone_periods,
             zone_transparency, fib_style_input, fib_thickness)

// ==================== SESSION 3: TOKYO ====================
if session3_enabled
    if is_session_start(session3_start)
        session3_active := true
        session3_start_bar := bar_index
        session3_high := high
        session3_low := low

    if session3_active
        session3_high := math.max(session3_high, high)
        session3_low := math.min(session3_low, low)

    if is_session_end(session3_end) and session3_active
        session3_active := false
        draw_session_box(session3_start_bar, bar_index, session3_high, session3_low,
             session3_color, get_border_style(box_style_input), box_thickness, box_transparency,
             session3_extend, session3_name, session3_fibonacci, session3_zone, zone_periods,
             zone_transparency, fib_style_input, fib_thickness)

// ==================== SESSION 4: FRANKFURT ====================
if session4_enabled
    if is_session_start(session4_start)
        session4_active := true
        session4_start_bar := bar_index
        session4_high := high
        session4_low := low

    if session4_active
        session4_high := math.max(session4_high, high)
        session4_low := math.min(session4_low, low)

    if is_session_end(session4_end) and session4_active
        session4_active := false
        draw_session_box(session4_start_bar, bar_index, session4_high, session4_low,
             session4_color, get_border_style(box_style_input), box_thickness, box_transparency,
             session4_extend, session4_name, session4_fibonacci, session4_zone, zone_periods,
             zone_transparency, fib_style_input, fib_thickness)
